# Copy settings individually into backend/.env. Never overwrite a working key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
MODEL_PATH=models/distilbert_20260916_013654/best_model
# After training AND evaluation, use the actual clinicalbert run's best_model path.
NATURAL_REPLIES=true
MAX_TEXT_CALLS=60
MAX_TRANSCRIPTIONS=20
MAX_SPEECH_CALLS=0
